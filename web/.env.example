# Copie para .env.local e preencha (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon

# ── Servidor (funções em web/api, Vercel). NÃO use prefixo VITE_: estas chaves não podem ir para o navegador. ──
# WhatsApp via Evolution API (confirmação de cadastro e código de redefinição de senha)
EVOLUTION_API_URL=https://zap.senszia.com
EVOLUTION_API_KEY=apikey-da-instancia
EVOLUTION_INSTANCE=nome-da-instancia-conectada
# Supabase > Project Settings > API > service_role (secreta!)
SUPABASE_SERVICE_ROLE_KEY=
